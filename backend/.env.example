# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=local
# Origin of the deployed frontend (comma-free, single origin) — used for CORS.
CLIENT_ORIGIN=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────
# Atlas connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/desitotes
MONGO_URI=

# ── Auth ───────────────────────────────────────────────
# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# ── Upstash Redis (REST API, not the classic redis:// URL) ─────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook you register in the Razorpay dashboard (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket ─────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# 6-digit pincode of your registered pickup address in Shiprocket
SHIPROCKET_PICKUP_PINCODE=
# Exact "Pickup location" nickname as set up in Shiprocket > Settings > Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=
# Shared secret you set on the Shiprocket webhook config, checked against the incoming request
SHIPROCKET_WEBHOOK_TOKEN=

# ── AWS S3 (product images) ─────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in your Resend account, e.g. "DesiTotes <orders@desitotes.com>"
EMAIL_FROM=
# Where customer replies and complaints go. EMAIL_FROM must be on a domain
# verified in Resend - a Gmail/Yahoo/Outlook address cannot be a sender, because
# those providers do not authorise anyone else to send as them. Put the shop's
# ordinary mailbox here instead and replies land in it.
EMAIL_REPLY_TO=

# How mail is sent: "resend" (default) or "gmail".
#   gmail  - signs in to the shop's mailbox with an app password and sends as
#            that address. No domain or DNS needed. Google caps it around 500
#            messages a day. Generate the password at
#            myaccount.google.com/apppasswords (2-Step Verification must be on).
#   resend - the API. No daily cap and better deliverability, but it can only
#            send from a domain verified in Resend.
EMAIL_TRANSPORT=resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
